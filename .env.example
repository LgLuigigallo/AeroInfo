# Supabase Credentials (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Transactional Emails (Resend or SMTP)
RESEND_API_KEY=re_your_api_key_here
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# Security & Background Job Authentication
CRON_SECRET=your_secure_cron_secret_key_here
ADMIN_SECRET_KEY=your_secure_admin_secret_key_here
